{
    "previewPort": 3000,
    "healthPath": "/",
    "startCommand": "docker compose -f docker-compose.base44.yml up -d",
    "secrets": [
        {
            "name": "OPENAI_API_KEY",
            "description": "OpenAI API key — https://platform.openai.com/api-keys"
        },
        {
            "name": "ANTHROPIC_API_KEY",
            "description": "Anthropic API key — https://console.anthropic.com/settings/keys"
        },
        {
            "name": "GOOGLE_API_KEY",
            "description": "Google AI Studio API key — https://aistudio.google.com/apikey"
        },
        {
            "name": "DEEPSEEK_API_KEY",
            "description": "DeepSeek API key — https://platform.deepseek.com/api_keys"
        },
        {
            "name": "OPENROUTER_API_KEY",
            "description": "OpenRouter API key — https://openrouter.ai/keys"
        },
        {
            "name": "XAI_API_KEY",
            "description": "xAI (Grok) API key — https://console.x.ai"
        },
        {
            "name": "GROQ_API_KEY",
            "description": "Groq API key — https://console.groq.com/keys"
        },
        {
            "name": "FRED_API_KEY",
            "description": "FRED (Federal Reserve macro data) API key — https://fred.stlouisfed.org/docs/api/api_key.html"
        }
    ]
}
